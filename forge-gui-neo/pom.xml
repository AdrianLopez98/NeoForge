<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-gui-neo</artifactId>
    <packaging>jar</packaging>
    <name>Forge Neo GUI</name>
    <description>Interfaz moderna (JavaFX) sobre el motor de Forge. Proyecto personal.</description>

    <properties>
        <javafx.version>21.0.5</javafx.version>
        <neo.mainClass>forge.neo.NeoMain</neo.mainClass>
        <!-- LA version de NeoForge, la que se anuncia en itch.io. Es el UNICO
             sitio donde se escribe: de aqui la leen el pie del menu (via
             build.properties) y el .dmg de Mac (mac/empaquetar.sh). Se sube
             solo al cerrar una version para publicar; entre medias la fecha de
             compilacion distingue una build de otra. -->
        <neo.version>3.8</neo.version>
        <!-- La fecha de compilacion, para sellarla en build.properties y poder
             ensenyar en el menu QUE motor se esta jugando. Se pasa por una
             propiedad propia a proposito: ${maven.build.timestamp} no se
             sustituye al filtrar recursos, y por eso hay que rebotarlo aqui. -->
        <maven.build.timestamp.format>yyyy-MM-dd</maven.build.timestamp.format>
        <neo.buildTime>${maven.build.timestamp}</neo.buildTime>
    </properties>

    <dependencies>
        <!-- Motor de Forge: se consume, nunca se modifica -->
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-game</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- La Aventura (el Adventure de Forge): su motor de mapa en libGDX y
             su lanzador de escritorio. Se abre en un proceso aparte y sus
             combates y su editor de mazos son los nuestros. Ver
             forge.neo.adventure.AdventureNeoMain. -->
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui-mobile-dev</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- NOTA: NO dependemos de forge-gui-desktop. Si algún día aparece esa
             dependencia aquí, es que nos hemos acoplado a la GUI vieja. -->

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Sonido: efectos y musica de la partida. El SoundSystem de Forge ya
             esta suscrito a los eventos por HostedMatch; esto es el altavoz. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Solo build.properties se filtra. El resto NO puede filtrarse: los
             diez ficheros de idioma y los scripts de las reliquias llevan
             ${...} y llaves que Maven intentaria sustituir. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>forge/neo/build.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>forge/neo/build.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Copia todas las dependencias de runtime a target/lib para poder
                 arrancar con  -cp "target/classes;target/lib/*"  sin pelearse
                 con el limite de longitud de linea de cmd.exe. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- mvn -pl forge-gui-neo exec:java  ->  arranca la app -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${neo.mainClass}</mainClass>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <systemProperties>
                        <systemProperty>
                            <key>file.encoding</key>
                            <value>UTF-8</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
